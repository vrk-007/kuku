# Pick ONE provider (gemini, openai, or anthropic) and fill in its key.
# The pipeline is model-agnostic: swap provider/model via CLI flags or here.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite

# Optional per-stage overrides (use exact model IDs from your provider's model list).
# Fall back to LLM_MODEL when unset.
# LLM_MODEL_BIBLE=
# LLM_MODEL_FINDER=
# LLM_MODEL_STITCHER=
# LLM_MODEL_JUDGE=

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
